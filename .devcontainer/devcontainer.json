{
  "name": "ha-sleeper",
  // Prebuilt image with Python 3.14 already compiled in, so the container builds
  // by download instead of compiling CPython from source. uv and the GitHub CLI
  // are added as lightweight features on top.
  "image": "mcr.microsoft.com/devcontainers/python:3-3.14-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "forwardPorts": [8123],
  "portsAttributes": {
    "8123": { "label": "Home Assistant", "onAutoForward": "notify" }
  },
  "postCreateCommand": "scripts/setup",
  "remoteUser": "vscode",
  "runArgs": ["--userns=keep-id", "--security-opt=label=disable"],
  "containerEnv": {
    "PYTHONASYNCIODEBUG": "1",
    "PYTHONDONTWRITEBYTECODE": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "redhat.vscode-yaml",
        "editorconfig.editorconfig",
        "ryanluker.vscode-coverage-gutters"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
      }
    }
  }
}
